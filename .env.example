# ── Required ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional (defaults shown) ──────────────────────────────────────────────────
LLM_MODEL=claude-sonnet-4-20250514
DATABASE_URL=sqlite+aiosqlite:///database/career_agent.db
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
EMAIL_MAX_WORDS=150

# Paths resolve relative to the repository root, not the current directory.
PROFILE_PATH=memory/profile.json
RESUME_PATH=memory/resume.pdf
PROJECTS_PATH=memory/projects.md
ACHIEVEMENTS_PATH=memory/achievements.md
PERSONALITY_PATH=prompts/personality.md

# Company lists use JSON array syntax. Environment overrides .env.
GREENHOUSE_COMPANIES=[]
LEVER_COMPANIES=[]
INCLUDE_YC_JOBS=true
MAX_CONCURRENT_SCRAPERS=3
